{
  "name": "@qmediat.io/ideogram-mcp",
  "version": "1.2.0",
  "mcpName": "io.github.qmediat/ideogram-mcp",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "description": "MCP server for Ideogram 3.0 and 4.0 (api.ideogram.ai v1): generate, edit (inpaint), remix, reframe, replace background, upscale and describe images — native fetch, two runtime dependencies",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ideogram-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ideogram",
    "ideogram-3",
    "image-generation",
    "ai",
    "model-context-protocol",
    "claude-code",
    "claude-desktop",
    "image-editing",
    "image-description",
    "upscale"
  ],
  "homepage": "https://www.qmediat.io/open-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmediat/ideogram-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/qmediat/ideogram-mcp/issues"
  },
  "author": "Quantum Media Technologies <dev@qmediat.io> (https://www.qmediat.io)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

{
  "name": "@qmediat.io/ideogram-mcp",
  "version": "2.5.0",
  "mcpName": "io.github.qmediat/ideogram-mcp",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "description": "MCP server for the Ideogram platform (api.ideogram.ai v2): every image and video model the platform sells through one API key — Ideogram 4.5/4.0/3.0, GPT Image, Nano Banana, Z-Image, P-Image, Topaz upscalers, Seedance/Kling/MiniMax video — the commercial tools (ad localizer/resizer/variations, colorways, ghost mannequin, material swap, pose variants, sketch to render) and the utilities (magic prompt, layerize logos, provenance, snap mask), with price quotes (dry_run), async generations you can resume, account usage, custom-model training, a discovery tool and a validated raw call; native fetch, two runtime dependencies",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ideogram-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "spec:generate": "node scripts/spec-generate.mjs",
    "spec:check": "node scripts/spec-generate.mjs --check",
    "docs:api": "node scripts/api-reference.mjs",
    "spec:pull": "node scripts/spec-pull.mjs",
    "lint": "eslint . && jscpd --config .jscpd.json && node lint/baseline-ratchet.mjs --duplicates .jscpd-report/jscpd-report.json",
    "fmt": "prettier \"**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "format": "npm run -s fmt -- --write",
    "format:check": "npm run -s fmt -- --check"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ideogram",
    "ideogram-3",
    "image-generation",
    "ai",
    "model-context-protocol",
    "claude-code",
    "claude-desktop",
    "image-editing",
    "image-description",
    "upscale"
  ],
  "homepage": "https://www.qmediat.io/open-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmediat/ideogram-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/qmediat/ideogram-mcp/issues"
  },
  "author": "Quantum Media Technologies <dev@qmediat.io> (https://www.qmediat.io)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "jscpd": "5.3.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

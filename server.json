{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.qmediat/ideogram-mcp",
  "description": "Ideogram platform MCP (api v2): 18 image models, price quotes, async generations, raw call",
  "repository": {
    "url": "https://github.com/qmediat/ideogram-mcp",
    "source": "github"
  },
  "version": "2.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@qmediat.io/ideogram-mcp",
      "version": "2.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Ideogram API key (create one at https://ideogram.ai/platform)",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "IDEOGRAM_API_KEY"
        },
        {
          "description": "Directory for saved images (default: /tmp/ideogram-output)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "IDEOGRAM_OUTPUT_DIR"
        }
      ]
    }
  ]
}
